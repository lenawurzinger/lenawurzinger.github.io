---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro"; 
---

<BaseLayout sideBarActiveItemID="cv">
  <div class="mb-10 flex items-center gap-3 flex-wrap">
    <h1 class="text-4xl font-bold">Lena Wurzinger</h1>

    <a
      href="/CV_new_April2026.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center rounded-full border border-neutral-300 px-3 py-1 text-sm text-neutral-700 hover:bg-neutral-100 transition"
      aria-label="Open CV PDF in a new tab"
    >
      CV PDF
    </a>
  </div>


  <div class="mb-5">
    <div class="text-3xl w-full font-bold"> </div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="PhD in Mathematics at ISTA (2023–present)"
      subtitle="Research in analytic number theory, supervised by "
    >
      <a
        href="https://tdbrowning.github.io/tdb/index.html"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
      >
        Tim Browning
      </a>
    </TimeLineElement>

    <TimeLineElement
      title="MSc in Mathematics at TU Graz & University of Graz (2022–2023)"
      subtitle="Research in additive combinatorics, supervised by "
    >
      <a
        href="https://www.math.tugraz.at/~elsholtz/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
      >
        Christian Elsholtz
      </a>
    </TimeLineElement>

    <TimeLineElement
      title="BSc in Mathematics at TU Graz & University of Graz (2018–2022)"
    />
  </div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Publications</div>
  </div>

  <div class="mb-10 grid gap-6">

    <div>
      <div class="font-semibold">[3] The divisor function for matrices sets</div>
      <div class="mt-1 text-sm">
        with
        <a
          href="https://tdbrowning.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          T.D. Browning</a>,
<a
          href="https://npkalinin.github.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          N.P. Kalinin</a>,
<a
          href="https://web.maths.unsw.edu.au/~alinaostafe/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          A. Ostafe</a>
        and
        <a
          href="https://sites.google.com/site/damarishomepage/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          D. Schindler
        </a>
      </div>
<a
            href="https://lenawurzinger.github.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-700 hover:underline"
          >
            arXiv
          </a>
        
      </div>
    </div>

    <div>
      <div class="font-semibold">[2] Sumset growth in progression-free sets</div>
      <div class="mt-1 text-sm">
        with
        <a
          href="https://www.math.tugraz.at/~elsholtz/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          C. Elsholtz
        </a>
        and
        <a
          href="https://www.renyi.hu/~ruzsa/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          I. Z. Ruzsa
        </a>
      </div>
      <div class="font-light text-sm">
        <em>Acta Arith.</em> 220 (2025), no. 3, 289–303
      </div>
      <div class="mt-1 flex gap-4 text-sm">
  <a
            href="/sumset_growth_erw.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-700 hover:underline"
          >
            PDF
          </a>
        <a
          href="https://www.impan.pl/en/publishing-house/journals-and-series/acta-arithmetica/all/220/3/116127/sumset-growth-in-progression-free-sets"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Journal
        </a>
      </div>
    </div>

    <div>
      <div class="font-semibold">[1] Sumsets in the set of squares</div>
      <div class="mt-1 text-sm">
        with
        <a
          href="https://www.math.tugraz.at/~elsholtz/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          C. Elsholtz
        </a>
      </div>
      <div class="font-light text-sm">
        <em>Q. J. Math.</em> 75 (2024), no. 4, 1243–1254
      </div>
      <div class="mt-1 flex gap-4 text-sm">
        <a
          href="/sumsets_squares.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          PDF
        </a>
        <a
          href="https://academic.oup.com/qjmath/article/75/4/1243/7749340"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Journal
        </a>
      </div>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Talks</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-3">
 <li>
      September 2026, Banff International Research Station (Banff, Canada), 
      <em>“<a
          href="https://www.birs.ca/events/2026/5-day-workshops/26w5546"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >Arithmetic, L-functions, and Pseudorandomness</a>”</em>:
      <em>The divisor function for matrices</em>.
    </li>
 <li>
      August 2026, EPFL Bernoulli Center (Lausanne, Switzerland), 
      <em>“<a
          href="https://www-lmpa.univ-littoral.fr/~ldevin/Fouvry73.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >Fouvry-73 Summer School</a>”</em>:
      <em>Lattices of fixed determinant</em>.
    </li>
  <li>
      April 2026, DoubleTree Hotel (Cheltenham, UK), 
      <em>“<a
          href="https://wings2026.github.io/#schedule"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >WINGS 2026</a>”</em>:
      <em>Towards lattices of fixed determinant</em>.
    </li>
    <li>
      February 2026, bifeb (Strobl am Wolfgangsee, Austria),
      <em>“<a
          href="https://www.math.tugraz.at/~elsholtz/WWW/elaz2026/elaz-info.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >ELAZ 2026</a>”</em>:
      <em>The arithmetic of cyclic covers in many variables </em>(flash talk). 
    </li>
    <li>
      July 2025, ISTA (Klosterneuburg, Austria) 
      <em>“<a
          href="https://sites.google.com/view/gntd/past-seminars_1/03-07-2025"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >Graz ISTA Number Theory Day</a>”</em>: 
      <em>Towards lattices of fixed determinant</em>.
    </li>
    <li>
      June 2025, CIRM (Marseille, France),
      <em>“<a
          href="https://conferences.cirm-math.fr/3213.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >Nombres premiers et aléa arithmétique</a>”</em>:
      <em>Sumset growth in progression-free sets</em>.
    </li>
    <li>
      September 2023, University of Graz (Graz, Austria), 
      <em>“<a
          href="https://imsc.uni-graz.at/oemg-tagung-2023/index.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >ÖMG Tagung 2023</a>”</em>:
      <em>Sumsets in the set of squares</em>.
    </li>
  </ul>

  <div class="mb-5">
  <div class="text-2xl w-full font-bold">Academic Service</div>
</div>

<div class="mb-10 grid gap-6">
    <div>
    <div class="font-semibold">
      Organiser of
      <a
        href="https://sites.google.com/view/gntd/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
      >
        Graz ISTA Number Theory Days
      </a>
      <span class="font-light text-sm"> · since 2024</span>
    </div>
    <ul class="list-disc mx-6 mt-2 grid gap-2">
      <li>
        Biannual joint seminar of ISTA and TU Graz (with
        <a
          href="https://tdbrowning.github.io/tdb/index.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Tim Browning,
        </a>
        <a
          href="https://www.math.tugraz.at/~frei/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Christopher Frei,
        </a> and
        <a
          href="https://sites.google.com/view/nickrome"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Nick Rome</a>).
      </li>
    </ul>
  </div>

  <div>
    <div class="font-semibold">
      Organiser of
      <a
        href="https://discreteanalysis.pages.ist.ac.at/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
      >
        Discrete Analysis Days
      </a>
      <span class="font-light text-sm"> · since 2025</span>
    </div>
    <ul class="list-disc mx-6 mt-2 grid gap-2">
      <li>
        Seminar at the intersection of combinatorics and number theory
        (with
        <a
          href="https://tdbrowning.github.io/tdb/index.html"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Tim Browning
        </a>
        and
        <a
          href="https://mkwn.github.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Matt Kwan</a>).
      </li>
    </ul>
  </div>

<div>
    <div class="font-semibold">
      Organiser of
      <a
        href="https://sites.google.com/view/mixcolloquium/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
      >
        Mathematics In eXchange (MIX) colloquium
      </a>
      <span class="font-light text-sm"> · 2024 – 2026</span>
    </div>
    <ul class="list-disc mx-6 mt-2 grid gap-2">
      <li>
        Monthly colloquium for PhD students at ISTA (with
        <a
          href="https://www.daniel-holmes.at/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Daniel Holmes,
        </a>
        <a
          href="https://sites.google.com/view/oleksii-kolupaiev/%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D0%B0%D1%8F-%D1%81%D1%82%D1%80%D0%B0%D0%BD%D0%B8%D1%86%D0%B0"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-700 hover:underline hover:underline-offset-2"
        >
          Oleksii Kolupaiev,
        </a> and
          Anna Zanoli), with a biannual joint colloquium with the Vienna School of Mathematics.
      </li>
 <li> Organisation of the ISTern Math Track Session – Flash Talk Competition, an annual event for mathematics summer interns at ISTA </li>
    </ul>
  </div>

<div>
    <div class="font-semibold">Referee</div>
    <div class="font-light text-sm">
      for <em>Acta Arith.</em> and <em>Proc. Amer. Math. Soc.</em>
    </div>
  </div>


</div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Teaching Experience</div>
  </div>

  <div class="mb-10 grid gap-6">
    <div>
      <div class="font-semibold">Teaching assistance at ISTA</div>
      <ul class="list-disc mx-6 mt-2 grid gap-2">
        <li>
          Some Applications of <em>p</em>-adic Integration to Geometry and
          Arithmetics <span class="font-light text-sm"> · 2025</span>
        </li>
      </ul>
    </div>

    <div>
      <div class="font-semibold">Teaching assistance at Erdős Center</div>
      <ul class="list-disc mx-6 mt-2 grid gap-2">
        <li>
          Recitation at the Summer School: Additive Combinatorics
          <span class="font-light text-sm"> · June 2024</span>
        </li>
      </ul>
    </div>

    <div>
      <div class="font-semibold">
        Teaching assistance at TU Graz
      </div>
      <ul class="list-disc mx-6 mt-2 grid gap-2">
        <li>
          Introduction to University Mathematics
          <span class="font-light text-sm"> · 2022</span>
        </li>
        <li>
          Mathematics for Chemistry I
          <span class="font-light text-sm"> · 2021</span>
        </li>
        <li>
          Discrete Mathematics for Computer Science
          <span class="font-light text-sm"> · 2021, 2022</span>
        </li>
        <li>
          Numerical Computation and Linear Algebra for Computer Science
          <span class="font-light text-sm"> · 2019, 2020, 2022</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-2xl w-full font-bold">Languages</div>
  </div>

  <ul class="list-disc md:columns-2 columns-1 mx-6 mb-10">
    <li>German (native)</li>
    <li>English (C1)</li>
    <li>French (B1)</li>
    <li>Russian (A2)</li>
    <li>Spanish (A2)</li>
    <li>Latin (basic knowledge)</li>
  </ul>
</BaseLayout>
