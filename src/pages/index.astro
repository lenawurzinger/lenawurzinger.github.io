---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Lena Wurzinger</div>
    <div class="text-2xl py-3 font-bold">PhD student in number theory</div>
    <div class="py-2">
      <text class="text-lg">
        Hi! I'm Lena Wurzinger, a PhD student at the 
        <a 
        href="https://www.ist.ac.at/en/home/"   target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
        >Institute of 
        Science and Technology Austria (ISTA)</a>, working under the supervision of  
        <a 
        href="https://tdbrowning.github.io/tdb/"   target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
        >
        Tim Browning. 
        </a> I am interested in analytic number theory, in particular the study of rational points 
        on varieties using tools from the geometry of numbers and the circle method. 
        I also work on problems in additive combinatorics, which was the focus of my MSc with 
        <a 
        href="https://www.math.tugraz.at/~elsholtz/"   target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
        >Christian Elsholtz</a>.
      </text>
  </div>
 <div class="py-2">
   <text class="text-lg">
      On this website, you can find 
<a 
        href="https://lenawurzinger.github.io/research/"   target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
        >
    my papers
</a>
and 
  <a 
        href="https://lenawurzinger.github.io/cv/"   target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:underline hover:underline-offset-2"
        >
    my CV.
</a>
      </text>
  </div>
<div class="py-2">
   <text class="text-lg">
      Contact: lena.wurzinger [@] ist.ac.at 
      </text>
  </div>
    <a
    id="cy-effective-orcid-url"
